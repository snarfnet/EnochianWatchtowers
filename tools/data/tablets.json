 "recensa1587": {
  "_about": "Great Table as reformed by Raphael, 20 April 1587 (BL Sloane MS 3191, \"Tabula bonorum angelorum invocationes\"). Primary transcription: J. H. Peterson, esotericarchives.com (HTML source + typeset image of the MS page). Cross-checked square by square against kondor.de. Arrangement: Air top-left, Water top-right, Earth bottom-left, Fire bottom-right.",
  "tablets": {
   "Air": {
    "positionInGreatTable": "top-left",
    "rowsOriginalCase": [
     "rZilafAytlpa",
